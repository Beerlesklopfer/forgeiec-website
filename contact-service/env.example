# /etc/forgeiec-contact/env  (root:root, mode 0600)
# Environment for forgeiec-contact.service. Lines are KEY=value, no quotes
# needed, no spaces around '='. See README.md for every variable.

# --- required -----------------------------------------------------------------
# At least 32 characters; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CONTACT_SECRET=
# Sender address of the notification mail (must be accepted by the local MTA
# and covered by SPF/DKIM of forgeiec.io).
CONTACT_MAIL_FROM=kontakt@forgeiec.io

# --- defaults (uncomment to change) -------------------------------------------
#CONTACT_MAIL_TO=blacksmith@forgeiec.io
#CONTACT_LISTEN_HOST=127.0.0.1
#CONTACT_PORT=8724
#CONTACT_TRUSTED_PROXIES=127.0.0.1,::1

# Local MTA on the web server: localhost:25, no TLS, no login (default).
#CONTACT_SMTP_HOST=localhost
#CONTACT_SMTP_PORT=25
#CONTACT_SMTP_SECURITY=none
#CONTACT_SMTP_TIMEOUT=15

# Only for a remote relay (not needed with the local MTA):
#CONTACT_SMTP_SECURITY=starttls
#CONTACT_SMTP_PORT=587
#CONTACT_SMTP_USER=
#CONTACT_SMTP_PASSWORD=
#CONTACT_SMTP_PASSWORD_FILE=

#CONTACT_RATE_PER_IP=5
#CONTACT_RATE_WINDOW=3600
#CONTACT_GLOBAL_PER_HOUR=30
#CONTACT_TOKEN_MIN_AGE=3
#CONTACT_TOKEN_MAX_AGE=7200
