<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:fv="https://forgeiec.io/v2/variable"
           targetNamespace="https://forgeiec.io/v2/variable"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:simpleType name="BooleanString">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="UnixTimestampMs">
    <xs:restriction base="xs:long">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="ForgeIecVar">
    <xs:annotation>
      <xs:documentation>
        Per-variable ForgeIEC-Metadata: Security-Flags
        (monitor/bellows/crossTask/force/addressLocked) plus
        Lifecycle-Timestamps. Element wird nur emittiert wenn
        mindestens ein Flag/Timestamp non-default ist. Reader
        behandelt fehlende Attribute als Default (false / 0).
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="monitorEnabled"   type="fv:BooleanString"   use="optional"/>
      <xs:attribute name="bellowsExport"    type="fv:BooleanString"   use="optional"/>
      <xs:attribute name="crossTaskExport"  type="fv:BooleanString"   use="optional"/>
      <xs:attribute name="force"            type="fv:BooleanString"   use="optional"/>
      <xs:attribute name="addressLocked"    type="fv:BooleanString"   use="optional"/>
      <xs:attribute name="createdMs"        type="fv:UnixTimestampMs" use="optional"/>
      <xs:attribute name="accessedMs"       type="fv:UnixTimestampMs" use="optional"/>
      <xs:attribute name="modifiedMs"       type="fv:UnixTimestampMs" use="optional"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
