<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  ForgeIEC v2 - Schema fuer PLCopen-XML-Extensions im Namespace
                "https://forgeiec.io/v2"
  ===========================================================================

  Copyright (c) ForgeIEC contributors. Licensed under AGPL-3.0-or-later.

  Dieses Schema spezifiziert die Form aller <addData>-Bloecke die ForgeIEC
  in seine .forge-Dateien (PLCopen-XML mit Vendor-Extensions) schreibt.
  Zugehoerige Sprint-Spec: documentation/sprints/plcopen-import-export.md
  Inventur dieser Schema-Elements: documentation/schemas/README.md.

  Pro Inner-Element existiert ein zugehoeriger `<data name="...">`-Wrapper
  in den .forge-Files:

    <data name="https://forgeiec.io/v2/variable">    -> <ForgeIecVar/>
    <data name="https://forgeiec.io/v2/task">        -> <ForgeIecTask/>
    <data name="https://forgeiec.io/v2/bus-config">  -> <fi:busConfig>...</>
    <data name="https://forgeiec.io/v2/comments">    -> <fi:comments>...</>

  Der `<data name="...">`-Wrapper IST PLCopen-Standard und wird von
  tc6_0201.xsd validiert. Dieses XSD validiert nur den Inhalt der
  Wrapper-Box (das eine Kind-Element pro <data>).

  Sanitize-map (https://forgeiec.io/v2/sanitize-map) liegt in eigenem
  Namespace + eigenem XSD documentation/schemas/forgeiec-v2-sanitize-map.xsd
  (User-Vorgabe 2026-05-21, neue Konvention: pro <data>-URI eigener xmlns).
  ===========================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:fi="https://forgeiec.io/v2"
           targetNamespace="https://forgeiec.io/v2"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- ====================================================================
       Common simple types
       ==================================================================== -->

  <xs:simpleType name="BooleanString">
    <xs:annotation>
      <xs:documentation>
        Boolean encoded as the strings "true"/"false". ForgeIEC writes
        only "true" (attribute omitted = false), Reader akzeptiert beide.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="UnixTimestampMs">
    <xs:annotation>
      <xs:documentation>
        Unix-Time in Millisekunden seit 1970-01-01T00:00:00Z (UTC).
        Wird fuer accessedMs/createdMs/modifiedMs-Lifecycle-Tracking
        auf Variablen verwendet (siehe FVariable::createdMs etc.).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:long">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ====================================================================
       <data name="https://forgeiec.io/v2/variable">
         -> <ForgeIecVar/>
       Per-variable security flags + monitor flag + lifecycle timestamps.
       Quelle: editor/src/model/FPlcopenXml.cpp ~Z. 290-322.
       ==================================================================== -->

  <xs:element name="ForgeIecVar">
    <xs:annotation>
      <xs:documentation>
        Per-variable ForgeIEC-Metadata: Security-Flags (monitor/bellows/
        crossTask/force/addressLocked) + Lifecycle-Timestamps. Attribute
        sind alle optional - das Element wird nur geschrieben wenn
        mindestens ein Flag/Timestamp non-default ist. Reader behandelt
        fehlende Attribute als Default (false / 0).
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="monitorEnabled"   type="fi:BooleanString"   use="optional"/>
      <xs:attribute name="bellowsExport"    type="fi:BooleanString"   use="optional"/>
      <xs:attribute name="crossTaskExport"  type="fi:BooleanString"   use="optional"/>
      <xs:attribute name="force"            type="fi:BooleanString"   use="optional"/>
      <xs:attribute name="addressLocked"    type="fi:BooleanString"   use="optional"/>
      <xs:attribute name="createdMs"        type="fi:UnixTimestampMs" use="optional"/>
      <xs:attribute name="accessedMs"       type="fi:UnixTimestampMs" use="optional"/>
      <xs:attribute name="modifiedMs"       type="fi:UnixTimestampMs" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       <data name="https://forgeiec.io/v2/task">
         -> <ForgeIecTask/>
       Per-task ForgeIEC-Erweiterungen die ueber PLCopen <task>-Attribute
       hinausgehen (RT-Scheduling, Watchdog-Timeout).
       Quelle: editor/src/model/FPlcopenXml.cpp ~Z. 922.
       ==================================================================== -->

  <xs:element name="ForgeIecTask">
    <xs:annotation>
      <xs:documentation>
        Per-task ForgeIEC-Metadata: Realtime-Scheduling-Flag und
        Watchdog-Timeout in Millisekunden. Bei rtScheduling=true wird
        die Task im SCHED_FIFO/RT-Modus gefahren (Permission noetig).
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="rtScheduling" type="fi:BooleanString"      use="optional"/>
      <xs:attribute name="watchdogMs"   type="xs:nonNegativeInteger" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       <data name="https://forgeiec.io/v2/bus-config">
         -> <fi:busConfig> + <fi:segment> + <fi:device> + <fi:module> +
            <fi:setting>
       Bus-System-Topologie unterhalb des <project>-Elements. Quelle:
       editor/src/model/FPlcopenXml.cpp ~Z. 1660-1830, docs/design/
       bus-panel-merge.md §2.2.
       ==================================================================== -->

  <xs:complexType name="Setting">
    <xs:annotation>
      <xs:documentation>
        Key/Value-Paar fuer Protocol-/Modul-/Device-spezifische
        Einstellungen (z.B. port, timeout_ms, baud_rate, log_path).
        Mehrfach vorkommend in `<fi:segment/>`, `<fi:device/>`, `<fi:module/>`.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="key"   type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Module">
    <xs:annotation>
      <xs:documentation>
        Bus-Modul innerhalb eines Devices (z.B. Klemmenmodul eines
        EtherCAT-Slaves). slot = positionale Reihenfolge im Geraet
        (0-basiert); catalogRef bindet auf einen FDD-Eintrag.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="setting" type="fi:Setting" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="slot"        type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="catalogRef"  type="xs:string"             use="optional"/>
    <xs:attribute name="name"        type="xs:string"             use="optional"/>
    <xs:attribute name="baseAddress" type="xs:integer"            use="optional"/>
  </xs:complexType>

  <xs:complexType name="Device">
    <xs:annotation>
      <xs:documentation>
        Bus-Device (z.B. Modbus-TCP-Slave, EtherCAT-Slave). `hostname`
        ist die User-sichtbare Bezeichnung; `id` ist eine GUID fuer
        stabile Bindings; `anvilGroup` mapt das Device auf einen
        Anvil-IPC-Topic-Group-Namen.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="setting" type="fi:Setting" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="module"  type="fi:Module"  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="hostname"       type="xs:string"             use="required"/>
    <xs:attribute name="id"             type="xs:string"             use="optional"/>
    <xs:attribute name="ipAddress"      type="xs:string"             use="optional"/>
    <xs:attribute name="port"           type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="slaveId"        type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="anvilGroup"     type="xs:string"             use="optional"/>
    <xs:attribute name="catalogRef"     type="xs:string"             use="optional"/>
    <xs:attribute name="mac"            type="xs:string"             use="optional"/>
    <xs:attribute name="timeoutMs"      type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="retryCount"     type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="endianness"     type="xs:string"             use="optional"/>
    <xs:attribute name="connectionMode" type="xs:string"             use="optional"/>
    <xs:attribute name="description"    type="xs:string"             use="optional"/>
    <xs:attribute name="gateway"        type="xs:string"             use="optional"/>
  </xs:complexType>

  <xs:complexType name="Segment">
    <xs:annotation>
      <xs:documentation>
        Bus-Segment = Protokoll + Network-Adresse + Liste von Devices.
        Ein Segment = ein Tongs-Daemon-Prozess auf der PLC. `protocol`
        z.B. "modbus-tcp", "ethercat", "profibus", "ethernet-ip".
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="setting" type="fi:Setting" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="device"  type="fi:Device"  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id"                    type="xs:string"             use="required"/>
    <xs:attribute name="protocol"              type="xs:string"             use="required"/>
    <xs:attribute name="name"                  type="xs:string"             use="required"/>
    <xs:attribute name="enabled"               type="fi:BooleanString"      use="required"/>
    <xs:attribute name="interface"             type="xs:string"             use="optional"/>
    <xs:attribute name="bindAddress"           type="xs:string"             use="optional"/>
    <xs:attribute name="gateway"               type="xs:string"             use="optional"/>
    <xs:attribute name="pollIntervalMs"        type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="subnetCidr"            type="xs:string"             use="optional"/>
    <xs:attribute name="sourcePortRange"       type="xs:string"             use="optional"/>
    <xs:attribute name="keepAliveIdleSec"      type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="keepAliveIntervalSec"  type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="keepAliveCount"        type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="maxConnections"        type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="vlanId"                type="xs:nonNegativeInteger" use="optional"/>
  </xs:complexType>

  <xs:element name="busConfig">
    <xs:annotation>
      <xs:documentation>
        Wurzel-Element des Bus-Konfigurations-Subtrees. Listet alle
        Segmente eines Projekts. Eingebettet in
        `<data name="https://forgeiec.io/v2/bus-config"/>` auf
        `<project/>`-Ebene.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="segment" type="fi:Segment" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       <data name="https://forgeiec.io/v2/comments">
         -> <fi:comments>
       Free-Text-Comment-Nodes die im Pool zwischen Variablen platziert
       werden (Section-Header etc.). Lesepfad in FPlcopenXml.cpp Z. 2908+.
       ==================================================================== -->

  <xs:element name="comments">
    <xs:annotation>
      <xs:documentation>
        Container fuer Free-Text-Kommentar-Knoten innerhalb einer
        Variablen-Liste. orderHint bestimmt die Position relativ
        zu Variablen + anderen Kommentaren.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="comment" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="doc" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>
                    Multi-Line-Doc-Text des Kommentars (XML-escaped).
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name"      type="xs:string"  use="required"/>
            <xs:attribute name="orderHint" type="xs:integer" use="optional" default="0"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
